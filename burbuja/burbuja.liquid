{%- comment -%}
  Burbuja «Pregúntale a la Dra. Melina» (Sebas 17:23, 17-nov): solo en la tienda (portada de la tienda, colecciones,
  búsqueda y fichas). Reemplaza la franja «¿No sabes cuál elegir?» de /pages/tienda.
  Mensaje por colección: 1) metacampo de la colección met.burbuja (texto; se edita en el admin sin tocar el tema);
  2) la lista de abajo; 3) el default. En una ficha se usa la primera colección del producto que tenga mensaje.
{%- endcomment -%}
{%- liquid
  assign en_tienda = false
  if template.name == 'product' or template.name == 'collection' or template.name == 'list-collections' or template.name == 'search'
    assign en_tienda = true
  elsif template.name == 'page' and template.suffix == 'met-tienda'
    assign en_tienda = true
  endif
  assign pregunta = '¿No sabes cuál elegir?'
  assign colecciones = blank
  if template.name == 'collection'
    assign colecciones = collection | sort
  elsif template.name == 'product'
    assign colecciones = product.collections
  endif
  for c in colecciones
    assign propia = c.metafields.met.burbuja.value | default: c.metafields.met.burbuja
    if propia != blank
      assign pregunta = propia
      break
    endif
    case c.handle
      when 'fotoproteccion', 'con-color'
        assign pregunta = '¿Qué SPF te conviene?'
        break
    endcase
  endfor
-%}
{%- if en_tienda -%}
{{ 'met-burbuja.css' | asset_url | stylesheet_tag }}
<script src="{{ 'met-burbuja.js' | asset_url }}" defer></script>
<div class="met-burbuja" data-ficha="{% if template.name == 'product' %}1{% endif %}" hidden>
  <button type="button" class="met-burbuja__boton" aria-expanded="false" aria-controls="met-burbuja-tarjeta" aria-label="Pregúntale a la Dra. Melina: abrir opciones de consulta">
    <img src="{{ 'met-dra.webp' | asset_url }}" alt="" width="60" height="60" loading="lazy">
    <span class="met-burbuja__punto" aria-hidden="true"></span>
  </button>
  <div class="met-burbuja__tarjeta" id="met-burbuja-tarjeta" role="dialog" aria-labelledby="met-burbuja-titulo" hidden>
    <button type="button" class="met-burbuja__cerrar" aria-label="Cerrar y no volver a mostrar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <p class="met-burbuja__quien"><span class="met-burbuja__punto met-burbuja__punto--linea" aria-hidden="true"></span>Dra. Melina Trujillo Quiroz</p>
    <p class="met-burbuja__titulo" id="met-burbuja-titulo">{{ pregunta }} <em>Te orientamos en consulta.</em></p>
    <div class="met-burbuja__acciones">
      <a class="met-burbuja__cita" href="https://www.doctoralia.com.mx/melina-trujillo-quiroz/ginecologo/ciudad-de-mexico" target="_blank" rel="noopener" data-met-evento="agendar_click" data-met-lugar="burbuja">Agendar consulta</a>
      <a class="met-burbuja__wa" href="https://wa.me/525540099923?text=Hola%2C%20tengo%20una%20duda%20sobre%20un%20producto%20de%20la%20tienda" target="_blank" rel="noopener" data-met-evento="whatsapp_click" data-met-lugar="burbuja">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>WhatsApp</a>
    </div>
    <small class="met-burbuja__cedulas">Cédulas profesionales 9177465 · 5574513</small>
  </div>
</div>
{%- endif -%}
